PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=duochat

# Strict 2-User Authentication Configuration
# DuoChat requires exactly two explicit users. No public registration is allowed.
DUO_USER1_EMAIL=user1@yourdomain.com
DUO_USER1_PASSWORD=SecurePasswordForUser1!

DUO_USER2_EMAIL=user2@yourdomain.com
DUO_USER2_PASSWORD=SecurePasswordForUser2!

# JWT Authentication Secret
# Must be a long, secure, unpredictable random string
JWT_SECRET=replace_with_a_very_secure_random_string

# Environment Mode
NODE_ENV=production
